# ═══════════════════════════════════════════════════
# SAIFEN — monorepo .gitignore
# ═══════════════════════════════════════════════════

# ─── Python (pipeline/) ────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ─── Jupyter (pipeline/notebooks/) ─────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── Dados intermediários (cache local, regenerável) ───────
data/processed/*.parquet
data/processed/*.feather
data/processed/*.cache
data/features/*.parquet
data/raw/manifest.json

# Perfis de comportamento enviados pelo app. Contêm dados pessoais e
# nunca devem ser versionados; cada instalação é local.
data/profiles/**
!data/profiles/.gitkeep

data/behavior/raw/**
!data/behavior/raw/.gitkeep
data/behavior/incoming/**
!data/behavior/incoming/.gitkeep
data/behavior/processed/**
!data/behavior/processed/.gitkeep

# Runs do pipeline (artefato estável fica em shared/heatmaps + current_run.json)
shared/runs/**
!shared/runs/.gitkeep

# ─── Node / Expo (mobile/) ─────────────────────────────────
node_modules/
.expo/
web-build/
*.tsbuildinfo
mobile/dist/
mobile/.expo/
mobile/dist-parity/

# ─── Supabase CLI (estado local) ───────────────────────────
supabase/.branches/
supabase/.temp/
supabase/.env

# ─── Segredos ──────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ─── OS / Editor ───────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Logs / Output efêmero ─────────────────────────────────
*.log
nohup.out

# ─── Manter exemplos vazios das pastas ─────────────────────
!data/raw/.gitkeep
!data/processed/.gitkeep
!shared/heatmaps/.gitkeep
!data/behavior/raw/.gitkeep
!data/behavior/incoming/.gitkeep
!data/behavior/processed/.gitkeep
!shared/behavior/.gitkeep
