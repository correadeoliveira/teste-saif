{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saifen.local/schema/heatmap_points.json",
  "title": "SAIFEN heatmap_points",
  "type": "object",
  "required": ["meta", "count", "points"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["generator", "generated_at", "version", "crime_type", "period"],
      "properties": {
        "generator": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "crime_type": {
          "type": "string",
          "enum": ["all", "furto", "roubo", "outros"]
        },
        "period": {
          "type": "string",
          "enum": ["all", "manha", "tarde", "noite", "madrugada"]
        }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "points": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "number" }
      }
    }
  }
}
