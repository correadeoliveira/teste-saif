{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saifen.local/schema/behavior_model.json",
  "title": "SAIFEN behavior model.json",
  "type": "object",
  "required": [
    "version",
    "type",
    "feature_names",
    "scaler",
    "coef",
    "intercept",
    "threshold",
    "window_ms",
    "overlap",
    "sample_rate_hz",
    "label_positive"
  ],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "type": { "const": "logistic_regression" },
    "feature_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "scaler": {
      "type": "object",
      "required": ["mean", "scale"],
      "properties": {
        "mean": { "type": "array", "items": { "type": "number" } },
        "scale": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } }
      }
    },
    "coef": { "type": "array", "items": { "type": "number" } },
    "intercept": { "type": "number" },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "window_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "overlap": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
    "sample_rate_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
    "label_positive": { "const": "genuine" }
  }
}
